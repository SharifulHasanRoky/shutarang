// Prisma schema for Shutarang — free social media manager with profiles + API + MCP

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// A profile = a workspace/brand/client. Each profile can hold unlimited accounts
// per platform (e.g. 3 Instagram accounts, 2 YouTube channels under one profile).
model Profile {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatarUrl   String?
  color       String   @default("emerald") // emerald | violet | sunset | ocean | rose | mono
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts       SocialAccount[]
  posts          ScheduledPost[]
  apiKeys        ApiKey[]
  smartLinks     SmartLink[]
  analytics      AnalyticsSnapshot[]
  inboxMessages  InboxMessage[]
}

model SocialAccount {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform    String   // instagram, tiktok, youtube, threads, twitter, twitch, gbp, bluesky, facebook, pinterest, linkedin
  handle      String
  displayName String
  url         String
  avatarUrl   String?
  followers   Int      @default(0)
  following   Int      @default(0)
  posts       Int      @default(0)
  verified    Boolean  @default(false)
  label       String?  // e.g. "Main", "Backup", "Client X account"
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([profileId, platform, handle])
}

model ScheduledPost {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  caption     String
  mediaUrls   String   @default("[]") // JSON array
  platforms   String   @default("[]") // JSON array of platform ids
  hashtags    String   @default("[]") // JSON array
  status      String   @default("draft") // draft | scheduled | published | failed
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsSnapshot {
  id             String   @id @default(cuid())
  profileId      String
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform       String
  date           String   // YYYY-MM-DD
  followers      Int      @default(0)
  followersGrowth Int     @default(0)
  reach          Int      @default(0)
  impressions    Int      @default(0)
  engagementRate Float    @default(0)
  likes          Int      @default(0)
  comments       Int      @default(0)
  shares         Int      @default(0)
  clicks         Int      @default(0)
  createdAt      DateTime @default(now())
}

model SmartLink {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  slug        String   @unique
  bio         String
  avatarUrl   String?
  theme       String   @default("violet") // violet | emerald | sunset | ocean | mono
  links       String   @default("[]") // JSON array of {label, url, icon}
  visits      Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InboxMessage {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform    String
  senderName  String
  senderHandle String
  senderAvatar String?
  message     String
  type        String   @default("comment") // comment | dm | mention
  postCaption String?
  isRead      Boolean  @default(false)
  isReplied   Boolean  @default(false)
  reply       String?
  createdAt   DateTime @default(now())
  repliedAt   DateTime?
}

// API keys for external AI tools / apps to access Shutarang via REST API or MCP.
model ApiKey {
  id         String   @id @default(cuid())
  name       String
  // The full key is shown ONCE at creation (sk_<32 hex chars>). We only persist:
  //   - prefix (first 10 chars, e.g. "sk_shutar_")  -> for display / lookup
  //   - keyHash (sha256 of full key)                -> for verification
  prefix     String
  keyHash    String   @unique
  profileId  String?  // null = access to all profiles; otherwise scoped to one profile
  profile    Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  scopes     String   @default("read,write,ai") // comma-separated
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  revokedAt  DateTime?
}
